{
  // Cloudflare Workers config for deploying the built static site.
  // `assets` alone serves the Vite build output in ./dist directly, which
  // stops Wrangler from trying to auto-configure the framework (that path
  // requires Vite 6+; this project is on Vite 5). `main` adds a Worker script
  // for the /api/photos/* routes (new inspection photos -> R2); any request
  // it doesn't handle falls through to the ASSETS binding for the static site.
  "name": "everest-container-terminal",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve index.html for unknown paths so client-side routes like /gate-in
    // and /photos work on refresh / deep link (the app uses BrowserRouter).
    "not_found_handling": "single-page-application",
    // Without this, the SPA fallback above answers GET /api/* with index.html
    // BEFORE the Worker runs, so GET /api/photos/view returned the app HTML
    // instead of the image (uploads use POST, which assets never serve, so
    // they were unaffected). Run the Worker first for API paths; everything
    // else still falls through to static assets + the SPA fallback.
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS_BUCKET",
      "bucket_name": "inspection-photos"
    }
  ],
  "vars": {
    // Both values are already public (embedded in the built frontend) --
    // no secret needed. Used only to verify the caller's Supabase JWT and
    // check their role before allowing R2 access.
    "SUPABASE_URL": "https://qctvjwlaxnidprhcxodj.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFjdHZqd2xheG5pZHByaGN4b2RqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTc2MDg1ODMsImV4cCI6MjA3MzE4NDU4M30.b0mOM6i2Go3qOvwgQytz_4TZcY3S4vOGzE_YmR0zxZc",
    // APM Terminals empty-return lookup (/api/terminal/empty-returns).
    // Production needs the Consumer Key/Secret from developer.apmterminals.com,
    // held as Worker secrets so they stay out of the repo (set them in the
    // Cloudflare dashboard, or with `npx wrangler secret put APM_CLIENT_ID`
    // and `... APM_CLIENT_SECRET`). Secrets survive a deploy; these vars do
    // not, which is why the URL and facility live here rather than there.
    // To go back to test data, point this at
    // https://api-sandbox.apmterminals.com with facility SEGOT — the sandbox
    // needs no credentials and knows only its four test containers.
    "APM_BASE_URL": "https://api.apmterminals.com",
    // Used when Terminal Check leaves the facility field blank: ACT Aqaba.
    "APM_DEFAULT_FACILITY": "JOAQJ"
  }
}
